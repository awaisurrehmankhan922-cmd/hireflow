# ---- copy to .env and change every value marked CHANGE ----
POSTGRES_PASSWORD=CHANGE-strong-db-password
DATABASE_URL=postgresql+psycopg2://hireflow:CHANGE-strong-db-password@db:5432/hireflow

JWT_SECRET=CHANGE-long-random-string
WEBHOOK_SECRET=CHANGE-shared-with-wordpress-plugin
WEBUI_SECRET_KEY=CHANGE-another-long-random-string
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=CHANGE-first-login-password

# AI: "ollama" (self-hosted, default) | "anthropic" (Claude API) | "mock" (demo/tests)
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
CONFIDENCE_THRESHOLD=0.7

# Designated mailbox
IMAP_HOST=imap.yourcompany.com
IMAP_PORT=993
IMAP_USER=careers@yourcompany.com
IMAP_PASSWORD=CHANGE
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USER=careers@yourcompany.com
SMTP_PASSWORD=CHANGE
MAIL_FROM=careers@yourcompany.com
MAIL_TRANSPORT=smtp

WORKER_INTERVAL_SECONDS=30
GATEWAY_PORT=8088
BACKUP_PASSPHRASE=CHANGE-store-this-offline
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
